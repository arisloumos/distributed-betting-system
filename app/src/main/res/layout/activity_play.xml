<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:id="@+id/tvGameTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" />

    <EditText android:id="@+id/etBet" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Enter Bet Amount" android:inputType="numberDecimal" android:layout_marginTop="20dp" />

    <Button android:id="@+id/btnPlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Place Bet" android:layout_marginTop="10dp" />

    <RatingBar android:id="@+id/ratingBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:visibility="gone" />

</LinearLayout>