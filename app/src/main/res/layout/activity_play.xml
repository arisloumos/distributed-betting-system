<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0D0D0F"
    android:gravity="center_horizontal">

    <!--preview για το παιχνίδι που επιλέχθηκε-->
    <ImageView
        android:id="@+id/ivGameBackground"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        android:layout_marginBottom="20dp" />

    <!--Τίτλος παιχνιδιού-->
    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp"/>

    <!--Πληροφορίες παιχνιδιού όπως όρια, rating, risk και jackpot-->
    <TextView
        android:id="@+id/tvGameInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#9CA3AF"
        android:lineSpacingExtra="4dp"
        android:textAlignment="center" />

    <!--Μικρό πλαίσιο όπου εμφανίζεται το live balance-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:background="#1A1B20"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:textStyle="bold"/>

        <!--TextView όπου εμφανίζεται το live balance-->
        <TextView
            android:id="@+id/tvLiveBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#9CFF22"
            android:text="..." />
    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1B20"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"/>

    <!--Section όπου ο χρήστης βάζει το ποσό και πατάει PLACE BET-->
    <LinearLayout
        android:id="@+id/layoutBetting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--Πεδίο εισαγωγής ποσού πονταρίσματος-->
        <EditText
            android:id="@+id/etBet"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Enter Bet Amount"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:backgroundTint="#9CFF22"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <!--Κουμπί για πονταρισμα-->
        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="PLACE BET"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#9CFF22"
            android:textColor="#050607" />
    </LinearLayout>

    <!--Section που εμφανίζεται μετά το αποτέλεσμα του πονταρίσματος-->
    <LinearLayout
        android:id="@+id/layoutResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center_horizontal">

        <!--Μήνυμα αποτελέσματος-->
        <TextView
            android:id="@+id/tvResultMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!--Label για την αξιολόγηση-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rate your experience"
            android:textColor="#9CA3AF"
            android:textSize="14sp"/>

        <!--RatingBar για αξιολόγηση -->
        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stepSize="1"
            android:numStars="5"
            android:progressTint="#9CFF22"
            android:secondaryProgressTint="#1A1B20" />

        <!--Σκιπ την αξιολόγηση-->
        <Button
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Skip &amp; Return"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1B20"
            android:layout_marginTop="24dp" />
    </LinearLayout>

</LinearLayout>